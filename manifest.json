{
  "manifest_version": 3,
  "name": "iCloud Hide My Email Bulk Deactivator",
  "version": "2.0",
  "description": "Trainable bot: bulk deactivate, permanently delete, and bulk-rename (label) iCloud Hide My Email addresses, with a never-delete protection list.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.icloud.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HME Bot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.icloud.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
